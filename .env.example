# PulseTrack environment template. Copy to .env (git-ignored) and fill in.
# Only EXPO_PUBLIC_* values are bundled into the app. NEVER put a service_role
# key, Gemini key or any secret here: they live in Supabase Edge Function secrets.

# Supabase Dashboard > Project Settings > API (project: PulseTrackApp)
EXPO_PUBLIC_SUPABASE_URL=
# Publishable (anon-equivalent) key. Safe to ship; protected by RLS.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the Family Live Alert web page. Links look like
#   <base>/alert/<incidentId>?token=<64-hex>
# Leave the placeholder until the Vercel deployment exists (Phase 5).
EXPO_PUBLIC_WEB_BASE_URL=https://pulsetrack.example.invalid

# Local dispatch number used by the Tier 2 SMS fallback (India unified: 112)
EXPO_PUBLIC_EMERGENCY_DISPATCH_PHONE=112
